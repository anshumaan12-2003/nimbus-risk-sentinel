# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbuspass
POSTGRES_DB=nimbus_db
DATABASE_URL=postgresql://nimbus:nimbuspass@postgres:5432/nimbus_db

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── AWS Credentials ─────────────────────────────────────────────────────
# Option 1: Access Key (for testing)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Option 2: IAM Role ARN (for production cross-account)
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/NimbusReadOnlyRole

# ─── App Config ──────────────────────────────────────────────────────────
APP_NAME=Breachpath Cloud Recon
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Scan Config ─────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=15
AWS_REGIONS=us-east-1,us-west-2,eu-west-1

# ─── Slack Notifications ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_ENABLED=false

# ─── Frontend ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
