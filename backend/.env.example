# Copy to backend/.env and fill in.  NEVER commit .env (it is in .gitignore).

# ─── Database ────────────────────────────────────────────────────────────
# Local quick start: SQLite.  Docker Compose / production: Postgres.
DATABASE_URL=sqlite:///./nimbus.db
# DATABASE_URL=postgresql+psycopg2://nimbus:nimbus@localhost:5432/nimbus

# ─── Redis / Celery (only needed when SCAN_EXECUTOR=celery) ─────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
SCAN_EXECUTOR=background        # background | celery
EVENTS_BACKEND=memory           # memory | redis  (redis required with celery)
SCAN_INTERVAL_MINUTES=60

# ─── AWS credentials — pick ONE (first match wins) ───────────────────────
# 1) Recommended for local dev: SSO / named profile (`aws configure sso`)
AWS_PROFILE=nimbus-scanner
# 2) Cross-account role (production / scanning other accounts)
# AWS_ROLE_ARN=arn:aws:iam::<TARGET_ACCOUNT_ID>:role/NimbusScannerRole
# AWS_EXTERNAL_ID=<random-string-from-trust-policy>
# 3) Static keys — last resort; rotate every 90 days
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

AWS_DEFAULT_REGION=ap-south-1
AWS_REGIONS=ap-south-1,us-east-1

# ─── Remediation safety ─────────────────────────────────────────────────
REMEDIATION_ENABLED=false
# AWS_REMEDIATION_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/NimbusRemediatorRole

# ─── Attack-graph crown jewels ──────────────────────────────────────────
CROWN_JEWEL_TAG_KEYS=data-classification,DataClassification,sensitivity,crown-jewel
CROWN_JEWEL_NAME_HINTS=prod,finance,customer,payment,pii,backup,billing

# ─── AI Copilot ─────────────────────────────────────────────────────────
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-flash-latest

# ─── App ─────────────────────────────────────────────────────────────────
APP_NAME=Nimbus Risk Sentinel
APP_VERSION=1.3.0
DEBUG=false
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Sign-in ─────────────────────────────────────────────────────────────
# REQUIRED. Signs every session token. The API refuses to start with a placeholder (unless DEBUG=true).
#   openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false            # true when served over HTTPS
COOKIE_SAMESITE=strict         # lax only if the UI and API are on different sites
PASSWORD_MIN_LENGTH=12
# SETUP_TOKEN=                 # optional: required to create the first admin from the browser

# Four-eyes: approver must be a different person from the requester.
# false = allow self-approval (solo personal account); audit rows say "self-approved".
REMEDIATION_TWO_PERSON_RULE=true
COPILOT_REQUESTS_PER_MINUTE=20

# ─── Slack ───────────────────────────────────────────────────────────────
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
