# Leave VITE_API_URL empty (recommended): the UI calls /api and /ws on its own origin and the
# Vite dev server proxies them to the backend. Same origin = no CORS, strict cookies.
VITE_API_URL=
# Where the proxy forwards to (dev server + `npm run preview`). Docker Compose sets http://api:8000.
# API_PROXY_TARGET=http://127.0.0.1:8000

# live = your real AWS data (default) · demo = built-in sample data for showcasing, no login
VITE_DATA_MODE=live
