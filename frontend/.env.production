# Build settings for the Vercel deploy. VITE_* values are bundled into public JS: never put secrets here.
# /api goes through the rewrite in vercel.json (same origin); Vercel can't proxy WebSockets, so the
# live feed connects to Render directly and authenticates with ?token=.
VITE_API_URL=
VITE_WS_URL=wss://nimbus-risk-sentinel-api.onrender.com
VITE_DATA_MODE=live
